{
  "ConnectionStrings": {
    "MyShoppingList": "Host=localhost;Database=MyShoppingList"
  },
  "Price": {
    "HistorySampleHours": 24
  },
  "Auth": {
    "TrialLifetimeHours": 3,
    "TrialRequestsPerWindow": 10,
    "TrialWindowSeconds": 3600
  },
  "ProductImport": {
    "Enabled": true,
    "SubmissionRequestsPerWindow": 20,
    "SubmissionWindowSeconds": 60,
    "PollSeconds": 1,
    "MaxAttempts": 3,
    "LeaseSeconds": 600,
    "RenewalSeconds": 30,
    "RetryDelaySeconds": 30
  },
  "RetailerHttp": {
    "TimeoutSeconds": 20,
    "MaximumResponseBytes": 2097152,
    "MaximumRedirects": 3
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Error",
      "Override": {
        "myshoppinglist_api.Workers.ProductImportWorker": "Information",
        "myshoppinglist_api.Services.ProductImportJobService": "Information",
        "myshoppinglist_api.Services.ProductImportSubmissionService": "Information"
      }
    },
    "WriteTo": [
      {"Name": "Console", "Args": {"outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"}},
      {"Name": "File", "Args": {
        "path": "logs/myshoppinglist-.log",
        "rollingInterval": "Day",
        "fileSizeLimitBytes": 10485760,
        "rollOnFileSizeLimit": true,
        "retainedFileCountLimit": 14,
        "shared": true,
        "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
      }}
    ]
  },
  "AllowedHosts": "*"
}
