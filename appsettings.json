{
  "ConnectionStrings": {
    "MyShoppingList": "Host=localhost;Database=MyShoppingList"
  },
  "Price": {
    "HistorySampleHours": 24
  },
  "RetailerHttp": {
    "TimeoutSeconds": 20,
    "MaximumResponseBytes": 2097152,
    "MaximumRedirects": 3
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {"Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning"}
    },
    "WriteTo": [{"Name": "Console"}]
  },
  "AllowedHosts": "*"
}
